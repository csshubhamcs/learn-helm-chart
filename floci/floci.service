# /etc/systemd/system/floci.service
#
# ExecStop is `stop`, never `down` — a reboot must never tear down your resources.
[Unit]
Description=Floci local cloud emulator
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/floci
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
User=ubuntu
Group=docker

[Install]
WantedBy=multi-user.target
